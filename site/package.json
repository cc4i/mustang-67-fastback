{
  "name": "e-mustang-3d-studio",
  "version": "3.6.0",
  "private": true,
  "type": "module",
  "description": "Interactive 3D Assembly & Kinematic Drive Studio for the 1:20 1967 Ford Mustang Fastback (Classic RC + Gemini AI Edition)",
  "scripts": {
    "copy-draco": "mkdir -p public/draco && cp node_modules/three/examples/jsm/libs/draco/gltf/draco_decoder.js node_modules/three/examples/jsm/libs/draco/gltf/draco_decoder.wasm node_modules/three/examples/jsm/libs/draco/gltf/draco_wasm_wrapper.js public/draco/",
    "postinstall": "npm run copy-draco",
    "predev": "npm run copy-draco",
    "dev": "vite",
    "prebuild": "npm run copy-draco",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
