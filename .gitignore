# Generated files (mustang/paths.py): deliverables and scratch
/output/
/tmp/

# Print, CAD and video artifacts, should one land outside output/ or tmp/
*.stl
*.3mf
*.gcode
*.mp4
!docs/images/*.mp4

# Blender: numbered save backups (.blend1, .blend2, ...) and the temp file written during a save
*.blend[0-9]*
*.blend@

# Python, Node & local secrets
.env
.env.*
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/
.venv/
venv/
node_modules/
site/node_modules/
site/dist/
site/public/draco/

# Agent harnesses: local state, personal overrides and indexes (shared config stays tracked)
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/.claude/worktrees/
CLAUDE.local.md
.codegraph/
.playwright-mcp/

